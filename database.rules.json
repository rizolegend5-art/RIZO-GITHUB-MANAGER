{
  "rules": {
    ".read": false,
    ".write": false,
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },
    "announcements": {
      ".read": "auth != null",
      "$id": {
        ".write": "auth != null && root.child('admins').child(auth.uid).val() === true",
        ".validate": "newData.hasChildren(['title','message','createdAt','audience','createdBy'])",
        "title": {
          " .validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 100"
        },
        "message": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 1000"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "audience": {
          ".validate": "newData.val() === 'all' || newData.val() === 'android'"
        },
        "createdBy": {
          ".validate": "newData.val() === auth.uid"
        }
      }
    },
    "devices": {
      ".read": "auth != null && root.child('admins').child(auth.uid).val() === true",
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || root.child('admins').child(auth.uid).val() === true)",
        "$deviceId": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['platform','updatedAt'])",
          "platform": {
            ".validate": "newData.val() === 'android'"
          },
          "pushToken": {
            ".validate": "newData.isString() && newData.val().length <= 500"
          },
          "updatedAt": {
            ".validate": "newData.isNumber()"
          }
        }
      }
    }
  }
}